# 이 파일은 변수 이름 템플릿입니다. 실제 값은 워크스페이스 밖 ~/.secrets/mosasaurus/ 에만 둡니다.
# --- app.env (컨테이너 주입, Phase 1) ---
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
ALLOWED_USER_ID=
# --- app.phase2.env (Phase 2 활성화 시에만 추가 주입) ---
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_ESCALATION=
DART_API_KEY=
# --- host.env (호스트 토큰 갱신기 전용, 컨테이너에는 주입하지 않음) ---
# KIS_APP_KEY, KIS_APP_SECRET, HOST_RUN_DIR, UPS_STATUS_COMMAND,
# OFFSITE_TARGET (SSD 밖 마운트 폴더: scripts/offsite_sync.sh 가 DB 백업을 복사)
