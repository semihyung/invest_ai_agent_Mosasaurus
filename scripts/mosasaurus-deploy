#!/bin/sh
# 배포 래퍼 (명세 3.4절). 운영자가 SSH 로 /usr/local/sbin/mosasaurus-deploy 에 root 소유·쓰기 금지로
# 수동 설치하고, sudoers 에는 `mosasaurus-runner ALL=(root) NOPASSWD: /usr/local/sbin/mosasaurus-deploy`
# 한 줄만 등록합니다. Runner 계정은 docker 그룹이 아니므로 금고를 읽을 수 없습니다.
#
# 사용: sudo -n /usr/local/sbin/mosasaurus-deploy <40자리 커밋 SHA>
set -eu

REPO_DIR="${REPO_DIR:-/home/pi/mosasaurus}"
APPROVED_DEPLOY="/usr/local/sbin/mosasaurus-safe-deploy"   # 운영자가 설치한 승인본(저장소 사본 실행 금지)
ALLOWED_SIGNERS_FILE="${ALLOWED_SIGNERS_FILE:-/etc/mosasaurus/allowed_signers}"
SHA="${1:-}"

case "$SHA" in
  *[!0-9a-f]*|"") echo "커밋 SHA 형식 오류"; exit 1 ;;
esac
[ "${#SHA}" -eq 40 ] || { echo "커밋 SHA 길이 오류"; exit 1; }

cd "$REPO_DIR"
git fetch origin main

# 1) origin/main 의 조상이어야 합니다.
git merge-base --is-ancestor "$SHA" origin/main || { echo "origin/main 의 조상이 아닌 커밋입니다"; exit 1; }

# 2) 허용된 운영자 서명 키로 서명된 커밋이어야 합니다(allowed_signers 는 SSH 서명 형식).
git -c gpg.ssh.allowedSignersFile="$ALLOWED_SIGNERS_FILE" verify-commit "$SHA" \
  || { echo "허용된 서명 키로 서명된 커밋이 아닙니다"; exit 1; }

# 3) 같은 SHA 의 클라우드 테스트 성공 여부는 호출한 워크플로우가 `needs: test` 로 보장하고,
#    래퍼는 추가로 GitHub 체크 결과 파일(워크플로우가 서명 없이 전달할 수 없는 값)을 믿지 않습니다.
#    운영자가 gh CLI 로 확인할 수 있도록 선택적 검증 훅을 제공합니다.
if [ -x /etc/mosasaurus/verify_ci_hook ]; then
  /etc/mosasaurus/verify_ci_hook "$SHA" || { echo "CI 검증 훅 실패"; exit 1; }
fi

[ -x "$APPROVED_DEPLOY" ] || { echo "승인된 safe_deploy 가 설치되어 있지 않습니다"; exit 1; }
exec env REPO_DIR="$REPO_DIR" "$APPROVED_DEPLOY" "$SHA"
